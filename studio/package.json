{
  "name": "ada-studio",
  "productName": "ADA Studio",
  "version": "0.1.0",
  "private": true,
  "description": "ADA Studio: viewport, diagnostics and chat for the ADA Surface kernel",
  "license": "UNLICENSED",
  "author": {
    "name": "benceboros2"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "prestart": "node scripts/check-node.cjs",
    "start": "electron-forge start",
    "prepackage": "node scripts/check-node.cjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
